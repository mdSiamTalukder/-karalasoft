# ---------------------------------------------------------------------------------
# KaralaSoft — contact form environment variables
# Copy to `.env.local` and fill in real values.  `.env.local` is git-ignored.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------------

# Resend API key — SERVER-ONLY. Create at https://resend.com/api-keys
# Never prefix this with NEXT_PUBLIC_; it must never reach the browser.
RESEND_API_KEY=

# Where contact submissions are delivered. Any address your Resend account can receive.
CONTACT_RECEIVER_EMAIL=

# Sender address shown in the "From" field.
#   • No verified domain yet → leave as `onboarding@resend.dev` (Resend's shared
#     testing sender; it can only deliver to your own Resend account address).
#   • After verifying a domain in Resend → use it, e.g. `KaralaSoft <hello@karalasoft.com>`
CONTACT_FROM_EMAIL=onboarding@resend.dev