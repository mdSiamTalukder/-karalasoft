# ---------------------------------------------------------------------------------
# KaralaSoft — environment variables
# Copy to `.env.local` and fill in real values.  `.env.local` is git-ignored.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------------

# ---------------------------------------------------------------------------------
# Admin Panel (optional — sensible defaults are built in)
# ---------------------------------------------------------------------------------

# Base URL of the existing KaralaSoft CRM API. Defaults to the production host, so you
# normally do NOT need to set this. SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# Point it at a local mock when testing the panel without touching real data.
#   ADMIN_API_BASE_URL=https://admin.karalasoft.com

# Origin that serves uploaded project images. The API returns site-relative paths such
# as `/images/projects/x.png`, so admin previews resolve them against this host.
#   ADMIN_MEDIA_ORIGIN=https://karalasoft.com

# ---------------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------------

# Hostinger mailbox password — SERVER-ONLY. The password for the mailbox below, set in
# hPanel → Email → Mailboxes. This is the Hostinger mailbox password, NOT a Gmail or
# hosting-panel password. Never prefix this with NEXT_PUBLIC_; it must never reach the
# browser.
HOSTINGER_EMAIL_PASSWORD=

# SMTP server (Hostinger). The defaults below already match Hostinger, so you normally
# only need to set HOSTINGER_EMAIL_PASSWORD.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# The Hostinger mailbox used to authenticate and to send as.
SMTP_USER=contact@karalasoft.com

# Where contact submissions are delivered. Leave blank to deliver to the SMTP_USER mailbox
# (contact@karalasoft.com).
CONTACT_RECEIVER_EMAIL=

# Sender address shown in the "From" field. Leave blank to send as the SMTP_USER mailbox.
CONTACT_FROM_EMAIL=